<?xml version="1.0" encoding="UTF-8" ?>
<!--
Verzija 1.0.0 - prva verzija
Verzija 1.0.1 - Fond sati i Broj sati promenjen tip u DecimalPozitivNulaTip
Verzija 1.0.2 - Sifra drzave je promenjena iz trokarakternog String-a u dvokarakterni String
Verzija 1.0.3 - Ogranicen DecimalPozitivTip i DecimalPozitivNulaTip na maxInclusive 9999999999999999.99
Verzija 1.0.4 - Fond sati i Broj sati vracen tip u DecimalPozitivN5.2Tip
Verzija 1.0.5 - TekuciRacunTip sklonjene crtice
-->
<xs:schema elementFormDefault="qualified" targetNamespace="http://pid.purs.gov.rs" version="1.4.3" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://pid.purs.gov.rs">
    <xs:element name="PodaciPoreskeDeklaracije" type="tns:PodaciPoreskeDeklaracijeTip"/>
    <xs:complexType name="MultifunkcionalnoPolje">
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element name="Oznaka" maxOccurs="1" minOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:string" id="MFPOznaka">
                        <xs:enumeration value="MFP.5"/>
                        <xs:enumeration value="MFP.7"/>
                        <xs:enumeration value="MFP.11"/>
                        <xs:enumeration value="MFP.12"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="Vrednost" maxOccurs="1" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="DecimalPozitivNulaTip">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:fractionDigits value="2"/>
            <xs:maxInclusive value="9999999999999999.99"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DecimalPozitivTip">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0"/>
            <xs:fractionDigits value="2"/>
            <xs:maxInclusive value="9999999999999999.99"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DecimalPozitivN5.2Tip">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0"/>
            <xs:maxInclusive value="744"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="PodaciOVrstamaPrihodaTip">
        <xs:sequence>
            <xs:element name="RedniBroj" maxOccurs="1" minOccurs="1" type="xs:positiveInteger"/>
            <xs:element name="SifraVrstePrihoda" maxOccurs="1" minOccurs="1" type="tns:SifraPrihodaTip"/>
            <xs:element name="BrojDana" maxOccurs="1" minOccurs="0" type="xs:nonNegativeInteger"/>
            <xs:element name="BrojSati" maxOccurs="1" minOccurs="0" type="tns:DecimalPozitivN5.2Tip"/>
            <xs:element name="FondSati" minOccurs="0" type="tns:DecimalPozitivN5.2Tip"/>
            <xs:element name="BrutoPrihod" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="OsnovicaZaPorez" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="ObracunatiPorez" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PorezPlacenDrugojDrzavi" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PorezZaUplatu" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="OsnovicaZaDoprinose" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PIO" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="ZDRAVSTVO" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="NEZAPOSLENOST" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="DeklarisaniMFP" maxOccurs="1" minOccurs="0">
                <xs:complexType>
                    <xs:sequence maxOccurs="unbounded" minOccurs="1">
                        <xs:element name="MFP" type="tns:MultifunkcionalnoPolje"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="JIPD">
        <xs:restriction base="xs:unsignedLong">
            <xs:totalDigits value="19"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="eMailAdresaTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9_]+([-+.&amp;#39;][A-Za-z0-9_]+)*@[A-Za-z0-9_]+([-.][A-Za-z0-9_]+)*\.[A-Za-z0-9_]+([-.][A-Za-z0-9_]+)*"/>
            <xs:minLength value="3"/>
            <xs:maxLength value="512"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="SedisteTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DrzavaTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="SifraPrihodaTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="(1(01|02|03|04|05|06|07|08|09|10|11|12|13)[0-9]{3}[0]{3})|100000001"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="PodaciOIsplatiocuTip">
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element name="PoreskiIdentifikacioniBroj" maxOccurs="1" minOccurs="1" type="tns:PIBJMBGTip"/>
            <xs:element name="ImePrezimeObveznika" type="tns:String512" minOccurs="0"/>
            <xs:element name="UlicaBrojPoreskogObveznika" minOccurs="0" type="tns:String512"/>
            <xs:element name="PrebivalisteOpstina" maxOccurs="1" minOccurs="1" type="tns:SedisteTip"/>
            <xs:element name="JMBGPodnosiocaPrijave" type="tns:JMBGTip"/>
            <xs:element name="TelefonKontaktOsobe" maxOccurs="1" minOccurs="0" type="tns:String255"/>
            <xs:element name="ElektronskaPosta" maxOccurs="1" minOccurs="1" type="tns:eMailAdresaTip"/>
            <xs:element name="DrzavaRezidenstva" minOccurs="0" type="tns:DrzavaTip"/>
            <xs:element name="BrojPasosa" maxOccurs="1" minOccurs="0" type="tns:String255"/>
            <xs:element name="BrojPoreskogPunomocnika" type="tns:PIBJMBGTip" minOccurs="0" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="DatumTip">
        <xs:restriction base="xs:date"></xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DatumMesecGodinaTip">
        <xs:restriction base="xs:date"></xs:restriction>
    </xs:simpleType>
    <xs:complexType name="PodaciOPrijaviTip">
        <xs:sequence>
            <xs:element name="KlijentskaOznakaDeklaracije" maxOccurs="1" minOccurs="0" type="tns:String255"/>
            <xs:element name="VrstaPrijave" maxOccurs="1" minOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="3"/>
                        <xs:enumeration value="4"/>
                        <xs:enumeration value="5"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="ObracunskiPeriod" maxOccurs="1" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:gYearMonth"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DatumOstvarivanjaPrihoda" maxOccurs="1" minOccurs="1" type="tns:DatumTip"/>
            <xs:element name="Rok">
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="DatumDospelostiObaveze" maxOccurs="1" minOccurs="1" type="tns:DatumTip"/>
            <xs:element name="DatumObracunaKamate" maxOccurs="1" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="tns:DatumTip"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="VrstaIzmenePrijave" maxOccurs="1" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                        <xs:enumeration value="3"/>
                        <xs:enumeration value="9"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="IdentifikatorPrijave" maxOccurs="1" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="tns:JIPD"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="PoNalazuKontroleSuda" maxOccurs="1" minOccurs="0" type="tns:String512"/>
            <xs:element name="OsnovIzmene" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                        <xs:enumeration value="3"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PodaciPoreskeDeklaracijeTip">
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element name="PodaciOPrijavi" maxOccurs="1" minOccurs="1" type="tns:PodaciOPrijaviTip"/>
            <xs:element name="PodaciOPoreskomObvezniku" maxOccurs="1" minOccurs="1" type="tns:PodaciOIsplatiocuTip"/>
            <xs:element name="PodaciONacinuOstvarivanjaPrihoda" maxOccurs="1" minOccurs="1" type="tns:PodaciONacinuOstvarivanjaPrihodaTip"/>
            <xs:element name="DeklarisaniPodaciOVrstamaPrihoda" maxOccurs="1" minOccurs="1">
                <xs:complexType>
                    <xs:sequence maxOccurs="unbounded" minOccurs="1">
                        <xs:element name="PodaciOVrstamaPrihoda" type="tns:PodaciOVrstamaPrihodaTip"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="Ukupno" type="tns:UkupnoTip" minOccurs="0"/>
            <xs:element name="Kamata" type="tns:KamataTip" minOccurs="0" maxOccurs="1"/>
            <xs:element name="PodaciODodatnojKamati" maxOccurs="1" minOccurs="0" type="tns:PodaciODodatnojKamatiTip"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PodaciONacinuOstvarivanjaPrihodaTip">
        <xs:sequence maxOccurs="1" minOccurs="1">
            <xs:element name="NacinIsplate" maxOccurs="1" minOccurs="1">
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                        <xs:enumeration value="3"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="TekuciRacun" maxOccurs="1" minOccurs="0" type="tns:TekuciRacunTip"/>
            <xs:element name="Ostalo" minOccurs="0" type="tns:String512"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="String255">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="255"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="KamataTip">
        <xs:sequence>
            <xs:element name="PorezZaUplatu" maxOccurs="1" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="OsnovicaZaDoprinose" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PIO" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="ZDRAVSTVO" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="NEZAPOSLENOST" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="UkupnoTip">
        <xs:sequence>
            <xs:element name="FondSati" minOccurs="0" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="BrutoPrihod" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="OsnovicaZaPorez" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="ObracunatiPorez" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PorezPlacenDrugojDrzavi" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PorezZaUplatu" maxOccurs="1" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="OsnovicaZaDoprinose" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="PIO" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="ZDRAVSTVO" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
            <xs:element name="NEZAPOSLENOST" minOccurs="1" type="tns:DecimalPozitivNulaTip"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="String512">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="512"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="PIBTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{9}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="TekuciRacunTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{18}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="MBRTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{8}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="JMBGTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{13}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="PIBJMBGTip">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{9}"/>
            <xs:pattern value="[0-9]{13}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="PodaciODodatnojKamatiTip">
        <xs:sequence>
            <xs:element name="KamataNaPorez-Por.Inspek." type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="KamataNaPIO-Por.Inspek." type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="KamataNaZdravstvo-Por.Inspek." type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="KamataNaNezaposl-Por.Inspek." type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="DatumDoKogaJeObracunataDodatnaKamata" type="tns:DatumTip" minOccurs="0"/>
            <xs:element name="DodatnaKamataNaPorez" type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="DodatnaKamataNaPIO" type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="DodatnaKamataNaZdravstvo" type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
            <xs:element name="DodatnaKamataNaNezaposlenost" type="tns:DecimalPozitivNulaTip" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>